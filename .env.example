# Sahayak Environment Configuration
PROJECT_NAME="Sahayak"
API_PORT=8000
DEMO_PORT=7860

# Database Configuration (MySQL / SQLite)
DATABASE_URL="sqlite:///./sahayak.db"
# For Docker MySQL: DATABASE_URL="mysql+pymysql://sahayak_user:sahayak_pass@mysql-db:3306/sahayak_db"

# Neo4j Knowledge Graph Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# JWT Auth Secret
JWT_SECRET_KEY="super_secret_sahayak_jwt_key_2026"

# External API Keys (Optional - System works offline with high-performance fallbacks)
OPENAI_API_KEY=""
JINA_API_KEY=""
SERPER_API_KEY=""
N8N_WEBHOOK_URL="http://localhost:5678/webhook/sahayak-dispatch"
